{
  "name": "puzzlegoals",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,vite -c blue,green \"nodemon server/index.js\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "nodemon server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "migrate": "node server/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@neondatabase/neon-js": "^0.7.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.5",
    "jose": "^6.2.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
